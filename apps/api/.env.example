# Konfigurasi Laravel untuk PENGEMBANGAN LOKAL (dijalankan di container `api`).
# Salin ke .env lalu buat APP_KEY:
#   docker compose run --rm api sh -c "cp .env.example .env && php artisan key:generate"
#
# Kredensial DB, Redis, dan host Mailpit TIDAK ditulis di sini. Nilainya disuntikkan
# oleh compose.yaml dari .env di root repo (environment variable menimpa file ini).

APP_NAME="Sentra Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin dashboard Next.js (CORS + domain stateful Sanctum).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime memakai sentra_app (tanpa DDL, tunduk RLS).
# Migrasi memakai koneksi `pgsql_owner` (sentra_owner): composer migrate
DB_CONNECTION=pgsql
DB_DATABASE=sentra

# Sesi di Redis (TAHAP_1_FONDASI §2). Idle 60 menit; batas absolut 12 jam ditegakkan aplikasi.
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# predis: murni PHP, tanpa ekstensi PECL (ADR 0007 D-40).
REDIS_CLIENT=predis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@sentra.test"
MAIL_FROM_NAME="${APP_NAME}"

# Cek password bocor (ADR 0007 D-39). Set false untuk menonaktifkan per environment.
PASSWORD_CHECK_UNCOMPROMISED=true
