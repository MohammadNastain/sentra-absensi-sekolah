# Konfigurasi produksi satu VPS. Salin ke .env di server, isi semua nilai GANTI, lalu `chmod 600 .env`.
# JANGAN commit .env. Buat kata sandi acak:  openssl rand -base64 36 | tr -d '/+='

# --- Image & domain ---
GHCR_OWNER=GANTI-nama-akun-github-huruf-kecil
IMAGE_TAG=latest
# Domain publik (placeholder). Aplikasi, API, dan terminal semuanya di domain ini.
SITE_ADDRESS=sekolah.contoh.my.id
ACME_EMAIL=GANTI@contoh.my.id

# --- Database & Redis ---
POSTGRES_SUPERUSER_PASSWORD=GANTI
SENTRA_DB_OWNER_PASSWORD=GANTI
SENTRA_DB_APP_PASSWORD=GANTI
REDIS_PASSWORD=GANTI

# --- Laravel ---
APP_NAME="Sentra Sekolah"
# Buat sekali:  docker run --rm ghcr.io/OWNER/sentra-api php artisan key:generate --show   (lalu simpan cadangan di tempat aman;
# kehilangan kunci ini membuat data terenkripsi dan sesi tidak terbaca).
APP_KEY=GANTI
APP_URL=https://sekolah.contoh.my.id
FRONTEND_URL=https://sekolah.contoh.my.id
SANCTUM_STATEFUL_DOMAINS=sekolah.contoh.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_LEVEL=warning

SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_DOMAIN=sekolah.contoh.my.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

PASSWORD_CHECK_UNCOMPROMISED=true

# --- Surel (transport nyata wajib; tanpa ini undangan/reset ditolak) ---
MAIL_MAILER=smtp
MAIL_HOST=GANTI
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=GANTI
MAIL_PASSWORD=GANTI
MAIL_FROM_ADDRESS=no-reply@contoh.my.id
MAIL_FROM_NAME="Sentra Sekolah"

# --- Mode demo & portal orang tua ---
# Demo hanya untuk lingkungan demo (data fiktif). NEXT_PUBLIC_DEMO_ENABLED dibakar saat build image web (lihat workflow).
DEMO_ENABLED=false
PARENT_PORTAL_RELEASED=false
