# Konfigurasi Docker Compose untuk PENGEMBANGAN LOKAL.
# Jangan edit file ini untuk menyimpan secret. Buat .env dengan:
#   node scripts/init-env.mjs
# Nilai __GENERATE__ akan diganti dengan string acak. File .env diabaikan git.

COMPOSE_PROJECT_NAME=sentra

# Port di host. Hanya di-bind ke 127.0.0.1 (tidak terbuka ke jaringan).
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_API_PORT=8000
FORWARD_MAILPIT_UI_PORT=8025

# UID/GID user di container PHP (relevan di host Linux/CI; di Windows boleh dibiarkan).
HOST_UID=1000
HOST_GID=1000

# --- Secret (dibangkitkan otomatis) ---
# Superuser PostgreSQL: hanya untuk administrasi container, BUKAN untuk aplikasi.
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
# Owner database: dipakai untuk migrasi.
SENTRA_DB_OWNER_PASSWORD=__GENERATE__
# Role runtime aplikasi: tanpa superuser, tanpa BYPASSRLS, tanpa DDL.
SENTRA_DB_APP_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
